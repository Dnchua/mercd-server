{
  "schemaVersion": 1,
  "module": "M6",
  "single_actor": true,
  "implementation_ready": true,
  "note": "M6 候选模拟器验收计划：覆盖 Bug1（公会设施 Lv.100+/蓄水库双锚点校验及日常战斗加成注入）与 暴走魔宠（首页活动快速跳转、遭遇强袭、出击、伤害上报、协力呼叫、击退、交换所及重启持久化）。未完成服务端改造与模拟器控件 inspect/calibrate 前禁止投入运行。",
  "flows": {
    "open_facility": [
      {
        "op": "click",
        "target": "nav.guild"
      },
      {
        "op": "click",
        "target": "m6.guild.facility_entry"
      },
      {
        "op": "visible",
        "target": "m6.guild.facility_panel"
      }
    ],
    "home_to_raid": [
      {
        "op": "click",
        "target": "nav.home"
      },
      {
        "op": "click",
        "target": "m6.home.activity_btn"
      },
      {
        "op": "wait",
        "seconds": 1
      },
      {
        "op": "swipe",
        "target": "m6.home.activity_list",
        "value": [
          0,
          -0.6
        ]
      },
      {
        "op": "wait",
        "seconds": 1
      },
      {
        "op": "click",
        "target": "m6.home.activity_raid_row"
      },
      {
        "op": "visible",
        "target": "m6.raid.page"
      }
    ],
    "start_daily_quest": [
      {
        "op": "click",
        "target": "m6.quest.entry"
      },
      {
        "op": "click",
        "target": "m6.quest.area_entry"
      },
      {
        "op": "click",
        "target": "m6.quest.target"
      },
      {
        "op": "click",
        "target": "m6.quest.start"
      },
      {
        "op": "visible",
        "target": "m6.battle.hud"
      }
    ]
  },
  "cases": [
    {
      "id": "M601",
      "title": "公会设施高等级（Lv.100+）与蓄水库双锚点数值校验",
      "criteria": [
        "M6-FACILITY-CAP-120",
        "M6-FACILITY-STORAGE-FORMULA"
      ],
      "depends_on": [],
      "steps": [
        {
          "op": "capture_sql",
          "sql": "${m6_01_snapshot_sql}",
          "params": [
            "${A_uid}"
          ],
          "as": "m6_01_before"
        },
        {
          "op": "mark"
        },
        {
          "flow": "open_facility",
          "role": "A"
        },
        {
          "op": "request",
          "path": "/guilds/",
          "role": "A",
          "timeout": 60
        },
        {
          "op": "text_equals",
          "target": "m6.guild.facility_sp_value",
          "value": "${m6_01_sp_text}"
        },
        {
          "op": "text_equals",
          "target": "m6.guild.facility_hp_value",
          "value": "${m6_01_hp_text}"
        },
        {
          "op": "text_equals",
          "target": "m6.guild.facility_at_value",
          "value": "${m6_01_at_text}"
        },
        {
          "op": "click",
          "target": "m6.guild.facility_next_page"
        },
        {
          "op": "text_equals",
          "target": "m6.guild.facility_toughness_value",
          "value": "${m6_01_toughness_text}"
        },
        {
          "op": "text_equals",
          "target": "m6.guild.facility_storage_value",
          "value": "${m6_01_storage_text}"
        },
        {
          "op": "assert_sql",
          "sql": "${m6_01_assert_sql}",
          "params": [
            "${A_uid}",
            "${m6_01_before}"
          ],
          "expected": 1
        }
      ]
    },
