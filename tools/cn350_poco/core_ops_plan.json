          "role": "A"
        },
        {
          "op": "assert_sql",
          "sql": "SELECT count(*) FROM cn35_player_monsters WHERE user_id=? AND unit_id IS NOT NULL",
          "params": [
            "${A_uid}"
          ],
          "expected": 1,
          "compare": "ge"
        }
      ]
    },
    {
      "id": "U10",
